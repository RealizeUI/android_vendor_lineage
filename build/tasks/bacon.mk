REALIZEUI_TARGET_PACKAGE := $(PRODUCT_OUT)/RealizeUI-$(REALIZEUI_VERSION).zip

SHA256 := prebuilts/build-tools/path/$(HOST_PREBUILT_TAG)/sha256sum

$(REALIZEUI_TARGET_PACKAGE): $(INTERNAL_OTA_PACKAGE_TARGET)
	$(hide) ln -f $(INTERNAL_OTA_PACKAGE_TARGET) $(REALIZEUI_TARGET_PACKAGE)
	$(hide) $(SHA256) $(REALIZEUI_TARGET_PACKAGE) | sed "s|$(PRODUCT_OUT)/||" > $(REALIZEUI_TARGET_PACKAGE).sha256sum
	@echo "Package Complete: $(REALIZEUI_TARGET_PACKAGE)" >&2

.PHONY: bacon
bacon: $(REALIZEUI_TARGET_PACKAGE) $(DEFAULT_GOAL)
